# Takedown Atlas - Alternative Ports (when default ports are in use)
# Copy this to .env if you have port conflicts with other projects

PROJECT_NAME=takedown_atlas

# Alternative database ports
POSTGRES_PORT=5433
POSTGRES_DB=takedown_atlas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Alternative Redis port
REDIS_PORT=6380

# Alternative MinIO ports
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# Alternative MailHog ports
MAILHOG_SMTP_PORT=1026
MAILHOG_WEB_PORT=8026
