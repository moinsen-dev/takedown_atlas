# Takedown Atlas - Infrastructure Ports Configuration
# Each project should use a different port range to avoid conflicts

# Project identifier (used for container names and network)
PROJECT_NAME=takedown_atlas

# Database ports (54xx range for takedown_atlas)
POSTGRES_PORT=5432
POSTGRES_DB=takedown_atlas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis port (63xx range)
REDIS_PORT=6379

# MinIO ports (90xx range)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# MailHog ports (80xx range)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# Alternative port ranges for conflict resolution:
# Uncomment these if you need to avoid conflicts with other projects

# POSTGRES_PORT=5433
# REDIS_PORT=6380
# MINIO_API_PORT=9002
# MINIO_CONSOLE_PORT=9003
# MAILHOG_SMTP_PORT=1026
# MAILHOG_WEB_PORT=8026
